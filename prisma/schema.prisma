// Catalog, inventory, and Better Auth foundation. Further modules require separate approval.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String    @unique
  active         Boolean   @default(true)
  sortOrder      Int       @default(0) @map("sort_order")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products       Product[]

  @@index([active, sortOrder, id])
  @@map("categories")
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  name           String
  slug           String           @unique
  description    String
  lifecycle      String           @default("draft")
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(6)
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variants       ProductVariant[]

  @@index([categoryId, lifecycle, createdAt, id])
  @@map("products")
}

model ProductVariant {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  sku              String            @unique
  sizeCode         String            @map("size_code")
  sizeLabel        String            @map("size_label")
  colorCode        String            @map("color_code")
  colorLabel       String            @map("color_label")
  priceMinor       BigInt            @map("price_minor")
  currency         String            @default("BDT") @db.Char(3)
  active           Boolean           @default(true)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryBalance InventoryBalance?
  stockMovements   StockMovement[]
  orderItems       OrderItem[]

  @@unique([productId, sizeCode, colorCode])
  @@unique([productId, id])
  @@index([productId, active, id])
  @@map("product_variants")
}

model InventoryBalance {
  variantId         String         @id @map("variant_id") @db.Uuid
  onHand            Int            @default(0) @map("on_hand")
  reserved          Int            @default(0)
  lowStockThreshold Int?           @map("low_stock_threshold")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Available stock is derived as onHand - reserved; no duplicate stored value.
  @@map("inventory_balances")
}

// Manual receiving/correction ledger only. Checks and append-only guards live in SQL.
model StockMovement {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId          String         @map("variant_id") @db.Uuid
  movementType       String         @map("movement_type")
  deltaOnHand        Int            @map("delta_on_hand")
  deltaReserved      Int            @default(0) @map("delta_reserved")
  onHandBefore       Int            @map("on_hand_before")
  onHandAfter        Int            @map("on_hand_after")
  reservedBefore     Int            @map("reserved_before")
  reservedAfter      Int            @map("reserved_after")
  actorAdminId       String         @map("actor_admin_id") @db.Uuid
  reason             String
  createdAt          DateTime       @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  idempotencyKey     String         @unique @map("idempotency_key") @db.Uuid
  requestFingerprint String         @map("request_fingerprint") @db.VarChar(64)
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin         AdminUser      @relation(fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([variantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorAdminId])
  @@map("stock_movements")
}

// Better Auth owns identity/session storage; application memberships are separate.
model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)
  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  adminUser        AdminUser?

  @@unique([email])
  @@map("auth_users")
}

model Session {
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  @@index([secret])
  @@index([userId])
  @@map("auth_two_factors")
}

enum AdminRoleName {
  OWNER
  PRODUCT_MANAGER
  ORDER_MANAGER
  MARKETING_MANAGER

  @@map("admin_role_name")
}

model AdminRole {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      AdminRoleName @unique
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique @map("user_id")
  roleId     String    @map("role_id") @db.Uuid
  active     Boolean   @default(false)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role       AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stockMovements StockMovement[]
  acknowledgedOrders Order[]
  orderEvents OrderEvent[]

  @@index([roleId])
  @@map("admin_users")
}

// Administrative foundation only. Customer authentication/claiming is not enabled.
model Customer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName String @map("display_name")
  phone String @map("phone_e164")
  email String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  accounts CustomerAccount[]
  orders Order[]
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([phone])
  @@map("customers")
}

model CustomerAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String @unique @map("customer_id") @db.Uuid
  identityIssuer String @map("identity_issuer")
  identitySubject String @map("identity_subject")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orders Order[]
  @@unique([identityIssuer, identitySubject])
  @@unique([customerId, id])
  @@map("customer_accounts")
}

model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber String @unique @map("order_number")
  customerId String @map("customer_id") @db.Uuid
  ownerAccountId String? @map("owner_account_id") @db.Uuid
  currency String @default("BDT") @db.Char(3)
  subtotalMinor BigInt @map("subtotal_minor")
  discountMinor BigInt @map("discount_minor")
  shippingMinor BigInt @map("shipping_minor")
  taxMinor BigInt @map("tax_minor")
  totalMinor BigInt @map("total_minor")
  paymentMode String @default("online_prepaid") @map("payment_mode")
  paymentStatus String @default("unpaid") @map("payment_status")
  fulfillmentStatus String @default("unfulfilled") @map("fulfillment_status")
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String? @map("acknowledged_by") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  contactName String @map("contact_name")
  contactPhone String @map("contact_phone")
  contactEmail String? @map("contact_email")
  shippingAddress String @map("shipping_address")
  shippingRuleSnapshot Json @map("shipping_rule_snapshot")
  policySnapshot Json @map("policy_snapshot")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  creationXid BigInt @default(dbgenerated("txid_current()")) @map("creation_xid")
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerAccount CustomerAccount? @relation(fields: [customerId, ownerAccountId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict)
  acknowledger AdminUser? @relation(fields: [acknowledgedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items OrderItem[]
  events OrderEvent[]
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerAccountId])
  @@index([acknowledgedBy])
  @@index([paymentStatus, createdAt(sort: Desc), id(sort: Desc)])
  @@index([fulfillmentStatus, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  productName String @map("product_name")
  sku String
  sizeLabel String @map("size_label")
  colorLabel String @map("color_label")
  quantity Int
  unitPriceMinor BigInt @map("unit_price_minor")
  discountMinor BigInt @map("discount_minor")
  totalMinor BigInt @map("total_minor")
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_items")
}

model OrderEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  kind String
  actorAdminId String? @map("actor_admin_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([orderId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorAdminId])
  @@map("order_events")
}

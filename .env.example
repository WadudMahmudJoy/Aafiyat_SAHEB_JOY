# Local development only. Replace password placeholders when copying to .env.
# The Compose service binds only to 127.0.0.1 and preserves its named volume.
POSTGRES_USER=aafiyat_dev
POSTGRES_PASSWORD=<LOCAL_DEV_PASSWORD>
POSTGRES_DB=aafiyat_dev
POSTGRES_PORT=55432

# Prisma runs on the host. Keep user/password/database/port in sync with values above.
# Percent-encode URL-special characters if changing the password.
DATABASE_URL="postgresql://aafiyat_dev:<URL_ENCODED_LOCAL_DEV_PASSWORD>@127.0.0.1:55432/aafiyat_dev?schema=public"

# Existing volumes retain their original credentials; changing .env does not reset them.
